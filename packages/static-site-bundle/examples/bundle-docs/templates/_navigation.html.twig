<div>

<nav aria-label="Documentation pages">
{% set group = '' %}
{% set activeSection = page.url|split('/')[1]|default('guide') %}
{% if activeSection not in ['guide', 'integration', 'api'] %}{% set activeSection = 'guide' %}{% endif %}
{% for item in pages %}
    {% set section = item.url|split('/')[1]|default('') %}
    {% if section == activeSection %}
        {% if section != group %}<h2 class="mt-6 mb-2 font-semibold capitalize">{{ section }}</h2>{% set group = section %}{% endif %}
        <a class="docs-nav-link block rounded px-3 py-1.5 text-sm {{ item.url == page.url ? 'docs-nav-link-current font-semibold' : 'text-[var(--docs-color-text-secondary)]' }}" href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.meta.title }}</a>
    {% endif %}
{% endfor %}
</nav>
</div>
