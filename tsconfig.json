{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/typescript-config/react.json",
  "compilerOptions": {
    "paths": {
      "@cjean-fr/jsx-string": ["./packages/jsx-string/src/index.ts"],
      "@cjean-fr/jsx-string/jsx-runtime": [
        "./packages/jsx-string/src/jsx-runtime.ts"
